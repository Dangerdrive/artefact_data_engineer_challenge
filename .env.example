# ===== Provider and Model (OpenAI-compatible: OpenAI, Groq, Together, etc.) =====
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-replace-with-your-key
# Optional: alternative endpoint for compatible providers
LLM_BASE_URL=

# ===== Policies RAG =====
# Embedding model (leave empty to use BM25 in the MVP)
EMBEDDING_MODEL=text-embedding-3-small

# ===== Persistence =====
# sqlite:///data/chat_history.db or memory to disable persistence
CONVERSATION_STORE=memory

# ===== Generation parameters (LLM mode) =====
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# ===== Logs =====
LOG_LEVEL=INFO
