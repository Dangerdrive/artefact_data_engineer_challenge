# ===== Provedor e Modelo (OpenAI-compatible: OpenAI, Groq, Together, etc.) =====
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-substitua-sua-chave
# Opcional: endpoint alternativo para provedores compatíveis
LLM_BASE_URL=

# ===== RAG de políticas =====
# Modelo de embeddings (deixe vazio para usar BM25 no MVP)
EMBEDDING_MODEL=text-embedding-3-small

# ===== Persistência =====
# sqlite:///data/chat_history.db ou memory para desabilitar persistência
CONVERSATION_STORE=memory

# ===== Logs =====
LOG_LEVEL=INFO
