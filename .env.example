# ===== Provider and Model =====
# DeepSeek is OpenAI-compatible. Any OpenAI-compatible endpoint also works
# (OpenAI, Groq, Together, local servers) by adjusting the values below.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
# Get a key at https://platform.deepseek.com — never commit the real key.
LLM_API_KEY=sk-replace-with-your-deepseek-key
# DeepSeek base URL (leave as is for DeepSeek; change it for other providers).
LLM_BASE_URL=https://api.deepseek.com

# Tip: "deepseek-chat" supports function calling (tools). "deepseek-reasoner"
# is available for reasoning-heavy use cases but does not support tools.

# ===== Policies RAG =====
# Embeddings are optional; the MVP uses keyword retrieval (BM25-style).
# Leave empty unless you add an embeddings-based retriever.
EMBEDDING_MODEL=

# ===== Persistence =====
# sqlite:///data/chat_history.db or memory to disable persistence
CONVERSATION_STORE=memory

# ===== Generation parameters (LLM mode) =====
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# ===== Logs =====
LOG_LEVEL=INFO
